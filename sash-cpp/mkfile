CXX=c++
AR=ar
BUILD=build
SANITIZE=
PLATFORM=`{uname -s | tr A-Z a-z}
CPPFLAGS=-Iinclude
CXXFLAGS=-std=c++17 -Wall -Wextra -Wpedantic -Werror -g
SASH=../target/release/sash
SASH_RT_LIB=../sash-rt/target/release/libsash_rt.a

build:V:
	case $PLATFORM in linux|darwin) ;; *) printf 'unsupported sash-cpp platform: %s\n' "$PLATFORM" >&2; exit 2;; esac &&
	if test -z "$BUILD"; then printf '%s\n' 'BUILD must not be empty' >&2; exit 2; fi &&
	mkdir -p $BUILD &&
	$CXX $CPPFLAGS $CXXFLAGS $SANITIZE -c src/runtime.cpp -o $BUILD/runtime.o &&
	$CXX $CPPFLAGS $CXXFLAGS $SANITIZE -c src/lifecycle.cpp -o $BUILD/lifecycle.o &&
	$CXX $CPPFLAGS $CXXFLAGS $SANITIZE -c src/platform_posix.cpp -o $BUILD/platform_posix.o &&
	$CXX $CPPFLAGS $CXXFLAGS $SANITIZE -c src/platform_$PLATFORM.cpp -o $BUILD/platform.o &&
	rm -f $BUILD/libsash_cpp.a &&
	$AR rcs $BUILD/libsash_cpp.a $BUILD/runtime.o $BUILD/lifecycle.o $BUILD/platform_posix.o $BUILD/platform.o &&
	$CXX $CPPFLAGS $CXXFLAGS $SANITIZE examples/greetings.cpp $BUILD/libsash_cpp.a -o $BUILD/greetings &&
	$CXX $CPPFLAGS $CXXFLAGS $SANITIZE examples/job_report.cpp $BUILD/libsash_cpp.a -o $BUILD/job_report &&
	$CXX $CPPFLAGS $CXXFLAGS $SANITIZE examples/stream_report.cpp $BUILD/libsash_cpp.a -o $BUILD/stream_report &&
	$CXX $CPPFLAGS $CXXFLAGS $SANITIZE examples/pipeline_report.cpp $BUILD/libsash_cpp.a -o $BUILD/pipeline_report &&
	$CXX $CPPFLAGS $CXXFLAGS $SANITIZE examples/capture_report.cpp $BUILD/libsash_cpp.a -o $BUILD/capture_report &&
	$CXX $CPPFLAGS $CXXFLAGS $SANITIZE examples/lifecycle_report.cpp $BUILD/libsash_cpp.a -o $BUILD/lifecycle_report &&
	$CXX $CPPFLAGS $CXXFLAGS $SANITIZE examples/option_report.cpp $BUILD/libsash_cpp.a -o $BUILD/option_report &&
	$CXX $CPPFLAGS $CXXFLAGS $SANITIZE examples/arithmetic_report.cpp $BUILD/libsash_cpp.a -o $BUILD/arithmetic_report &&
	$CXX $CPPFLAGS $CXXFLAGS $SANITIZE examples/error_paths.cpp $BUILD/libsash_cpp.a -o $BUILD/error_paths

fixtures:V: build
	$CXX $CPPFLAGS $CXXFLAGS tests/command_helper.cpp -o $BUILD/command-helper &&
	cp tests/no-shebang.sh $BUILD/not-executable &&
	chmod 644 $BUILD/not-executable &&
	cp tests/no-shebang.sh $BUILD/no-shebang &&
	chmod 755 $BUILD/no-shebang

test:V: fixtures
	$CXX $CPPFLAGS $CXXFLAGS $SANITIZE tests/runtime.cpp $BUILD/libsash_cpp.a -o $BUILD/runtime-tests &&
	timeout 30 $BUILD/runtime-tests $BUILD/command-helper &&
	timeout 10 $BUILD/greetings > $BUILD/greetings.actual &&
	cmp examples/greetings.expected $BUILD/greetings.actual &&
	timeout 10 $BUILD/job_report > $BUILD/job_report.actual &&
	cmp examples/job_report.expected $BUILD/job_report.actual &&
	timeout 10 $BUILD/stream_report > $BUILD/stream_report.actual &&
	cmp examples/stream_report.expected $BUILD/stream_report.actual &&
	timeout 10 $BUILD/pipeline_report > $BUILD/pipeline_report.actual &&
	cmp examples/pipeline_report.expected $BUILD/pipeline_report.actual &&
	timeout 10 $BUILD/capture_report > $BUILD/capture_report.actual &&
	cmp examples/capture_report.expected $BUILD/capture_report.actual &&
	timeout 10 $BUILD/lifecycle_report > $BUILD/lifecycle_report.actual &&
	cmp examples/lifecycle_report.expected $BUILD/lifecycle_report.actual &&
	timeout 10 $BUILD/option_report > $BUILD/option_report.actual &&
	cmp examples/option_report.expected $BUILD/option_report.actual &&
	timeout 10 $BUILD/arithmetic_report > $BUILD/arithmetic_report.actual &&
	cmp examples/arithmetic_report.expected $BUILD/arithmetic_report.actual

error-demo:V: fixtures
	if test "$PLATFORM" != linux; then printf '%s\n' 'error-demo requires Linux (strace and subreaper containment)' >&2; exit 2; fi &&
	if test -n "$SANITIZE"; then printf '%s\n' 'error-demo requires an unsanitized BUILD (strace and deliberate faults)' >&2; exit 2; fi &&
	$CXX $CPPFLAGS $CXXFLAGS -static tests/error_supervisor.cpp -o $BUILD/error-supervisor &&
	bash examples/error_paths.sh $BUILD

fault-test:V: test
	if test "$PLATFORM" != linux; then printf '%s\n' 'fault-test requires Linux strace injection' >&2; exit 2; fi &&
	timeout 10 strace -qq -e trace=clone -e inject=clone:error=EAGAIN:when=1 -o $BUILD/fork-failure.trace $BUILD/runtime-tests --fork-failure $BUILD/command-helper &&
	grep -qE 'clone.*EAGAIN.*INJECTED' $BUILD/fork-failure.trace &&
	timeout 10 strace -qq -e trace=clone,close,wait4 -e inject=clone:error=EAGAIN:when=2 -o $BUILD/pipeline-fork-failure.trace $BUILD/runtime-tests --pipeline-fork-failure $BUILD/command-helper &&
	grep -qE 'clone.*EAGAIN.*INJECTED' $BUILD/pipeline-fork-failure.trace &&
	timeout 10 strace -qq -e trace=wait4 -e inject=wait4:error=EIO:when=1 -o $BUILD/pipeline-wait-failure.trace $BUILD/runtime-tests --pipeline-wait-failure $BUILD/command-helper &&
	grep -qE 'wait4.*EIO.*INJECTED' $BUILD/pipeline-wait-failure.trace &&
	timeout 10 strace -qq -e trace=wait4 -e inject=wait4:error=EINTR:when=1 -o $BUILD/wait-interrupted.trace $BUILD/runtime-tests --wait-interrupted $BUILD/command-helper &&
	grep -qE 'wait4.*EINTR.*INJECTED' $BUILD/wait-interrupted.trace &&
	timeout 10 strace -qq -e trace=rt_sigaction -e inject=rt_sigaction:error=EIO:when=1 -o $BUILD/signal-install-failure.trace $BUILD/runtime-tests --signal-install-failure $BUILD/command-helper &&
	grep -qE 'rt_sigaction\(SIGUSR1,.*EIO.*INJECTED' $BUILD/signal-install-failure.trace &&
	timeout 10 strace -qq -e trace=rt_sigaction -e inject=rt_sigaction:error=EIO:when=1 -o $BUILD/signal-END-install-failure.trace $BUILD/runtime-tests --signal-END-install-failure $BUILD/command-helper &&
	grep -qE 'rt_sigaction\(SIGUSR1,.*EIO.*INJECTED' $BUILD/signal-END-install-failure.trace &&
	timeout 10 strace -qq -e trace=rt_sigprocmask,rt_sigaction -e inject=rt_sigprocmask:error=EIO:when=3 -o $BUILD/signal-END-mask-failure.trace $BUILD/runtime-tests --signal-END-mask-failure $BUILD/command-helper &&
	grep -qE 'rt_sigprocmask\(SIG_BLOCK,.*EIO.*INJECTED' $BUILD/signal-END-mask-failure.trace &&
	! grep -q 'rt_sigaction(' $BUILD/signal-END-mask-failure.trace &&
	if timeout 10 strace -qq -e trace=rt_sigaction -e inject=rt_sigaction:error=EIO:when=2 -o $BUILD/signal-restore-failure.trace $BUILD/runtime-tests --signal-restore-failure $BUILD/command-helper > $BUILD/signal-restore-failure.out 2> $BUILD/signal-restore-failure.err; then
		printf '%s\n' 'signal restoration fault did not fail' >&2; exit 1
	else
		status=$?; test "$status" -eq 2
	fi &&
	grep -qE 'rt_sigaction\(SIGUSR1,.*EIO.*INJECTED' $BUILD/signal-restore-failure.trace &&
	grep -q '__END_BEFORE_RESTORE__' $BUILD/signal-restore-failure.err &&
	grep -q 'cleanup failed: restore signal disposition' $BUILD/signal-restore-failure.err &&
	if timeout 10 strace -qq -e trace=rt_sigprocmask -e inject=rt_sigprocmask:error=EIO:when=1 -o $BUILD/lifecycle-handoff-failure.trace $BUILD/runtime-tests --lifecycle-handoff-failure $BUILD/command-helper > $BUILD/lifecycle-handoff-failure.out 2> $BUILD/lifecycle-handoff-failure.err; then
		printf '%s\n' 'lifecycle initialization fault did not fail' >&2; exit 1
	else
		status=$?; test "$status" -eq 2
	fi &&
	grep -qE 'rt_sigprocmask\(SIG_BLOCK,.*EIO.*INJECTED' $BUILD/lifecycle-handoff-failure.trace &&
	grep -q 'cleanup failed: initialize lifecycle signal state' $BUILD/lifecycle-handoff-failure.err &&
	! grep -q '__HANDOFF_END__' $BUILD/lifecycle-handoff-failure.err &&
	if timeout 10 strace -qq -e trace=rt_sigprocmask -e inject=rt_sigprocmask:error=EIO:when=3 -o $BUILD/lifecycle-restore-handoff-failure.trace $BUILD/runtime-tests --lifecycle-restore-handoff-failure $BUILD/command-helper > $BUILD/lifecycle-restore-handoff-failure.out 2> $BUILD/lifecycle-restore-handoff-failure.err; then
		printf '%s\n' 'lifecycle restoration fault did not fail' >&2; exit 1
	else
		status=$?; test "$status" -eq 2
	fi &&
	grep -qE 'rt_sigprocmask\(SIG_BLOCK,.*EIO.*INJECTED' $BUILD/lifecycle-restore-handoff-failure.trace &&
	grep -q 'cleanup failed: block signals during lifecycle restoration' $BUILD/lifecycle-restore-handoff-failure.err &&
	grep -q '__HANDOFF_END__' $BUILD/lifecycle-restore-handoff-failure.err &&
	timeout 10 strace -qq -e trace=pipe2,fcntl,close,prlimit64 -o $BUILD/dup-failure.trace $BUILD/runtime-tests --dup-failure $BUILD/command-helper &&
	grep -qE 'pipe2\(\[0, [0-9]+\], O_CLOEXEC\).* = 0' $BUILD/dup-failure.trace &&
	grep -qE 'fcntl\(0, F_DUPFD_CLOEXEC, 3\).*EMFILE' $BUILD/dup-failure.trace &&
	timeout 10 strace -f -qq -e trace=execve,write -e inject=write:error=ENOMEM:when=1 -o $BUILD/exec-failure.trace $BUILD/runtime-tests --exec-failure $BUILD/command-helper &&
	grep -qE 'execve\(.*command-helper[.]missing.*ENOENT' $BUILD/exec-failure.trace &&
	! grep -qE 'write\(([013-9]|[0-9]{2,}),' $BUILD/exec-failure.trace &&
	bash tests/capture_faults.sh $BUILD

fmt:V:
	clang-format --dry-run --Werror include/sash/runtime.hpp src/*.hpp src/*.cpp examples/*.cpp tests/*.cpp

sash-example:V:
	mkdir -p $BUILD &&
	SASH_RT_LIB=$SASH_RT_LIB $SASH examples/greetings.sash -o $BUILD/greetings-sash &&
	timeout 10 $BUILD/greetings-sash > $BUILD/greetings-sash.actual &&
	cmp examples/greetings.expected $BUILD/greetings-sash.actual &&
	SASH_RT_LIB=$SASH_RT_LIB $SASH examples/job_report.sash -o $BUILD/job_report-sash &&
	timeout 10 $BUILD/job_report-sash > $BUILD/job_report-sash.actual &&
	cmp examples/job_report.expected $BUILD/job_report-sash.actual &&
	SASH_RT_LIB=$SASH_RT_LIB $SASH examples/stream_report.sash -o $BUILD/stream_report-sash &&
	timeout 10 $BUILD/stream_report-sash > $BUILD/stream_report-sash.actual &&
	cmp examples/stream_report.expected $BUILD/stream_report-sash.actual &&
	SASH_RT_LIB=$SASH_RT_LIB $SASH examples/pipeline_report.sash -o $BUILD/pipeline_report-sash &&
	timeout 10 $BUILD/pipeline_report-sash > $BUILD/pipeline_report-sash.actual &&
	cmp examples/pipeline_report.expected $BUILD/pipeline_report-sash.actual &&
	SASH_RT_LIB=$SASH_RT_LIB $SASH examples/capture_report.sash -o $BUILD/capture_report-sash &&
	timeout 10 $BUILD/capture_report-sash > $BUILD/capture_report-sash.actual &&
	cmp examples/capture_report.expected $BUILD/capture_report-sash.actual &&
	SASH_RT_LIB=$SASH_RT_LIB $SASH examples/lifecycle_report.sash -o $BUILD/lifecycle_report-sash &&
	timeout 10 $BUILD/lifecycle_report-sash > $BUILD/lifecycle_report-sash.actual &&
	cmp examples/lifecycle_report.expected $BUILD/lifecycle_report-sash.actual &&
	SASH_RT_LIB=$SASH_RT_LIB $SASH examples/option_report.sash -o $BUILD/option_report-sash &&
	timeout 10 $BUILD/option_report-sash > $BUILD/option_report-sash.actual &&
	cmp examples/option_report.expected $BUILD/option_report-sash.actual &&
	SASH_RT_LIB=$SASH_RT_LIB $SASH examples/arithmetic_report.sash -o $BUILD/arithmetic_report-sash &&
	timeout 10 $BUILD/arithmetic_report-sash > $BUILD/arithmetic_report-sash.actual &&
	cmp examples/arithmetic_report.expected $BUILD/arithmetic_report-sash.actual
