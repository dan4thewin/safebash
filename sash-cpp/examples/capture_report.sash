fn worker_summary {
    str text=$(/usr/bin/printf 'Grace\nAda\nGrace\nEdsger\nAda\n' |
        /usr/bin/env LC_ALL=C /usr/bin/sort |
        /usr/bin/uniq |
        /usr/bin/paste -sd , - |
        /usr/bin/tr -d '\n')
    attest text [[ $text =~ '^[A-Za-z]+(,[A-Za-z]+)*$' ]]
    echo $text
}

fn framed_summary {
    str value=$(worker_summary)
    echo "[$value]"
}

array summaries
int round=0
while (( round < 2 )) {
    (( round += 1 ))
    summary=$(worker_summary)
    summaries[$round]=$summary
    framed=$(framed_summary)
    echo "round $round: $summary"
    echo "framed $round: $framed"
}
for summary in @summaries {
    echo "saved: $summary"
}
int probe_status=0
probe=$(/usr/bin/false | /bin/cat) || probe_status=$(status)
attest probe [[ $probe == '' ]]
if (( probe_status == 0 )) {
    echo 'unexpected capture success'
} else {
    echo 'failed capture detected'
}
echo complete
