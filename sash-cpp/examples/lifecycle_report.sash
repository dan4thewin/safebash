fn collect_workers {
    int seen=0
    /usr/bin/printf 'Ada\nGrace\n' | while readline person {
        attest person [[ $person =~ '^[A-Za-z]+$' ]]
        (( seen += 1 ))
        A[$seen]=$person
    }
    /usr/bin/printf 'collected:%s' $seen
}

fn finished_status -> int {
    echo "result discarded"
    return 7
}

array workers
summary=$(collect_workers =workers)
attest summary [[ $summary =~ '^collected:[0-9]+$' ]]
echo "capture: $summary"
- finished_status
echo "body complete"
exit 0

EXIT {
    int incoming=$?
    echo "EXIT: incoming $incoming"
    /usr/bin/false || {
        echo "EXIT: caught $?"
    }
    - /usr/bin/false
    echo "EXIT: discarded"
    for person in @workers {
        echo "EXIT: saved $person"
    }
}

ERR {
    int failure=$?
    - echo "ERR: incoming $failure"
}
