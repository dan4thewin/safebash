#!/bin/bash
# spec/31.4.sh — mutation in condition position rejected
#

set -eu
. common.sh
setup 31.4
plan=3
echo "1..$plan" >&3

set +e
# assignment in if (( )) is rejected
run_sash 'if (( x = 5 )); then echo yes; fi'
[[ rc = 1 && -z $out && $err = SB1234* ]]; chk 31.4a

# += in if (( )) is rejected
run_sash 'int x=1; if (( x += 1 )); then echo yes; fi'
[[ rc = 1 && -z $out && $err = SB1234* ]]; chk 31.4b

# x++ in if (( )) is rejected
run_sash 'int x=1; if (( x++ )); then echo yes; fi'
[[ rc = 1 && -z $out && $err = SB1234* ]]; chk 31.4c

tally
