#!/bin/bash
# safebash pre-commit hook.
#
# Enforced gates (block on failure):
#   - cargo fmt --check (sash, sash-convert, sash-expand)
#   - cargo clippy -D warnings (sash, sash-convert)
#
# Report-only gates (printed, never block):
#   - top-5 cyclomatic complexity from .indexnudge-rust.db
#
# Bypass: SKIP_HOOKS=1 git commit ...     (skips all)
#         git commit --no-verify ...      (skips all, hard escape)
#
# Set SKIP_COMPLEXITY=1 to skip just the report.

set -eu

if [ "${SKIP_HOOKS:-0}" = "1" ]; then
    echo "pre-commit: SKIP_HOOKS=1, skipping all checks" >&2
    exit 0
fi

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

red()   { printf '\033[31m%s\033[0m\n' "$1"; }
green() { printf '\033[32m%s\033[0m\n' "$1"; }
gray()  { printf '\033[90m%s\033[0m\n' "$1"; }

# --- fmt -------------------------------------------------------------
gray "pre-commit: cargo fmt --check"
fmt_failed=0
for crate in sash sash-convert sash-expand; do
    if [ -d "$crate" ]; then
        if ! (cd "$crate" && cargo fmt --check >/dev/null 2>&1); then
            red "  FAIL: $crate has unformatted code"
            red "        run: (cd $crate && cargo fmt)"
            fmt_failed=1
        fi
    fi
done
[ "$fmt_failed" -eq 0 ] && green "  ok"
[ "$fmt_failed" -eq 0 ] || exit 1

# --- lint ------------------------------------------------------------
gray "pre-commit: cargo clippy -D warnings"
lint_failed=0
for crate in sash sash-convert sash-expand; do
    if [ -d "$crate" ]; then
        if ! (cd "$crate" && cargo clippy --quiet -- -D warnings 2>&1 | tail -20 >/tmp/.pre-commit-clippy.$$); then
            red "  FAIL: $crate has clippy warnings"
            cat /tmp/.pre-commit-clippy.$$ >&2
            lint_failed=1
        fi
        rm -f /tmp/.pre-commit-clippy.$$
    fi
done
[ "$lint_failed" -eq 0 ] && green "  ok"
[ "$lint_failed" -eq 0 ] || exit 1

# --- complexity (report only) ----------------------------------------
# Excludes any fn whose `// cyclo-allow: ...` comment sits within the
# contiguous doc-comment / attribute / blank-line block immediately
# above `fn`. The walk-up handles the idiomatic Rust shape where
# rustdoc /// comments must sit directly above the function.
if [ "${SKIP_COMPLEXITY:-0}" != "1" ] && [ -f .indexnudge-rust.db ]; then
    gray "pre-commit: complexity report (top 5, report-only)"
    sqlite3 .indexnudge-rust.db "
WITH RECURSIVE attached(file, line_num, sym_file, sym_start, content, depth) AS (
    SELECT s.file, s.start_line-1, s.file, s.start_line,
           (SELECT content FROM lines
            WHERE file=s.file AND line_num=s.start_line-1), 1
    FROM symbols s
    WHERE s.kind IN ('function','method')
      AND s.cyclomatic IS NOT NULL
      AND s.file LIKE 'sash/src/%'
    UNION ALL
    SELECT a.file, a.line_num-1, a.sym_file, a.sym_start,
           (SELECT content FROM lines
            WHERE file=a.file AND line_num=a.line_num-1), a.depth+1
    FROM attached a
    WHERE a.depth < 12
      AND a.content IS NOT NULL
      AND (
        TRIM(a.content) LIKE '///%'
        OR TRIM(a.content) LIKE '//!%'
        OR TRIM(a.content) LIKE '// cyclo-allow:%'
        OR TRIM(a.content) LIKE '#[%'
        OR TRIM(a.content) = ''
      )
),
allowed AS (
    SELECT DISTINCT sym_file, sym_start
    FROM attached
    WHERE TRIM(content) LIKE '// cyclo-allow:%'
)
SELECT s.cyclomatic, s.name, s.file||':'||s.start_line
FROM symbols s
WHERE s.kind IN ('function','method')
  AND s.cyclomatic IS NOT NULL
  AND s.file LIKE 'sash/src/%'
  AND NOT EXISTS (
    SELECT 1 FROM allowed a
    WHERE a.sym_file = s.file AND a.sym_start = s.start_line
  )
ORDER BY s.cyclomatic DESC LIMIT 5;" 2>/dev/null | sed 's/^/  /'
fi

green "pre-commit: all gates green"
