# .cyclo-allow — functions excluded from `contrib/cyclo.sh` reports.
#
# Format: `path::function_name # rationale`
# Blank lines and lines starting with `#` are ignored.
#
# Inclusion criteria (DG 2026-05-31):
#   1. All B-verdicts from r47-abstraction-audit.md — declarative
#      tables, 1:1 mappings, or pure traversals where each arm is
#      trivial. CC algorithm overcounts; a human reviewer reads the
#      function fine.
#   2. C-verdicts where the candidate extraction would occur fewer
#      than 2 times (no DRY win, only nominal flattening).
#
# Each entry below ALSO has an inline `// cyclo-allow: <reason>`
# comment above the corresponding `fn`. Keep the two in sync.
#
# To inspect what's being filtered: `bash contrib/cyclo.sh sash/src --show-allowed`

# ── B-verdicts ──────────────────────────────────────────────────────

# codegen/setup.rs
sash/src/codegen/setup.rs::intern_inst    # SsaInst variant traversal — 1-line arms
sash/src/codegen/setup.rs::intern_value   # SsaValue variant traversal — 1-line arms

# parse/lexer.rs
sash/src/parse/lexer.rs::scan_dollar      # pure byte-dispatcher into existing scanners
sash/src/parse/lexer.rs::next_token       # cleared in r47 phase 6; logos-driven dispatch

# parse/logos_tokens.rs
sash/src/parse/logos_tokens.rs::to_tok    # pure 1:1 logos-token → Tok mapping

# parse/expr.rs
sash/src/parse/expr.rs::keyword_to_str    # pure 1:1 Tok → &str

# parse/arith.rs
sash/src/parse/arith.rs::tok_to_text      # pure 1:1 Tok → String formatter
sash/src/parse/arith.rs::match_arith_op2  # 1:1 byte → token, two-byte ops
sash/src/parse/arith.rs::match_arith_op1  # 1:1 byte → token, single-byte ops
sash/src/parse/arith.rs::binary_op_for    # declarative Tok → (ArithOp, prec) table

# parse/parser.rs
sash/src/parse/parser.rs::parse_regex_rhs # Tok → char mapping for regex specials
sash/src/parse/parser.rs::parse_redirect  # Tok → (fd, op) dispatch — 1 arm per redirect op

# transform/expr_handlers.rs
sash/src/transform/expr_handlers.rs::fold_arith_op # small ArithOp dispatcher, 1-3 lines per arm
sash/src/transform/expr_handlers.rs::ir_op_to_ssa  # 1:1 IR → SSA op enum

# transform/expressions.rs
sash/src/transform/expressions.rs::expr_to_string  # pure ExprKind → String formatter

# ssa.rs (ArithOp impls)
sash/src/ssa.rs::from_str   # 1:1 str → ArithOp
sash/src/ssa.rs::display    # 1:1 ArithOp → str
sash/src/ssa.rs::as_u8      # 1:1 ArithOp → byte

# ssa_taint.rs
sash/src/ssa_taint.rs::value_is_tainted  # SsaValue dispatch + 15-arm cmd-basename table
sash/src/ssa_taint.rs::check_value_use   # SsaValue traversal — 1-line arms

# ssa_printer.rs
sash/src/ssa_printer.rs::print_value     # SsaValue dispatcher, trivial formatting

# ir.rs
sash/src/ir.rs::child_bodies   # IR helper — explicitly intended to be reused everywhere
sash/src/ir.rs::direct_exprs   # IR helper — same as above for exprs

# printer.rs
sash/src/printer.rs::print_arith_expr  # mostly inline op-table strings + simple recursion

# emit_janet.rs
sash/src/emit_janet.rs::arith_expr_to_janet # ArithExpr dispatch with three op-string tables
sash/src/emit_janet.rs::_stmt_uses_args     # pure StmtKind → bool traversal
sash/src/emit_janet.rs::emit_expr_inline    # ExprKind dispatch, mostly trivial mapping

# type_check.rs
sash/src/type_check.rs::expr_type   # small ExprKind → VarType dispatcher

# ── C-verdicts whose extraction would repeat <2 times ───────────────

# codegen/setup.rs
sash/src/codegen/setup.rs::init_positional_params  # top-level driver, mostly linear

# codegen/entry.rs
sash/src/codegen/entry.rs::compile_ssa  # top-level codegen driver: setup + one block loop

# codegen/redirects.rs
sash/src/codegen/redirects.rs::lower_ir_redirect_expr  # ExprKind → (ptr, len), one shape per arm

# parse/lexer.rs
sash/src/parse/lexer.rs::scan_brace_expansion  # bracket-counting with quote-state; coherent

# parse/expr.rs
sash/src/parse/expr.rs::string_parts_to_exprs  # per-StringPart dispatch, modest

# parse/parser.rs
sash/src/parse/parser.rs::parse_local    # `local x=v` parser — mostly linear
sash/src/parse/parser.rs::parse_command  # simple command parser, modest

# transform/cmd_handlers.rs
sash/src/transform/cmd_handlers.rs::handle_function_call_or_command  # function inlining; linear plumbing

# transform/helpers.rs (after child_bodies rollout, see if these can drop)
# (Not whitelisted — these are C-verdicts that DO get refactored
# under the child_bodies rollout because the pattern repeats.)

# validate.rs
sash/src/validate.rs::check_dq_stmt   # status state-machine; already well-structured

# emit_janet.rs
sash/src/emit_janet.rs::emit_stmt        # StmtKind dispatcher; modest
sash/src/emit_janet.rs::emit_redirected  # per-redirect-op codegen; modest

# printer.rs
sash/src/printer.rs::print_stmt  # StmtKind dispatcher, 5-10 lines per arm
sash/src/printer.rs::print_expr  # ExprKind dispatcher, modest

# type_check.rs
sash/src/type_check.rs::infer_stmt  # StmtKind dispatcher; modest
